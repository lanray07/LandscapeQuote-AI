default_platform(:ios)

require "shellwords"

APP_IDENTIFIER = "com.landscapequoteai.app"
SIGNING_IDENTITY = ENV["SIGNING_IDENTITY"].to_s.empty? ? "iPhone Distribution" : ENV["SIGNING_IDENTITY"]

def env_present?(key)
  ENV[key].to_s.length.positive?
end

def repo_root
  File.expand_path("..", __dir__)
end

def repo_path(*parts)
  File.join(repo_root, *parts)
end

def expanded_env_path(key)
  path = ENV[key].to_s
  return path if path.start_with?("/")

  File.expand_path(path, repo_root)
end

def provisioning_xcargs(include_team:)
  args = ["-allowProvisioningUpdates"]
  args << "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}" if include_team && env_present?("APPLE_TEAM_ID")

  if env_present?("ASC_KEY_FILE") && env_present?("ASC_KEY_ID") && env_present?("ASC_ISSUER_ID")
    args << "-authenticationKeyPath #{Shellwords.escape(expanded_env_path('ASC_KEY_FILE'))}"
    args << "-authenticationKeyID #{ENV['ASC_KEY_ID']}"
    args << "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
  end

  args.join(" ")
end

def signing_xcargs(profile_name:)
  [
    provisioning_xcargs(include_team: true),
    "CODE_SIGN_STYLE=Manual",
    Shellwords.escape("CODE_SIGN_IDENTITY=#{SIGNING_IDENTITY}"),
    Shellwords.escape("PROVISIONING_PROFILE_SPECIFIER=#{profile_name}")
  ].join(" ")
end

def signing_keychain_options
  return {} unless env_present?("SIGNING_KEYCHAIN_PATH")

  options = { keychain_path: expanded_env_path("SIGNING_KEYCHAIN_PATH") }
  options[:keychain_password] = ENV["SIGNING_KEYCHAIN_PASSWORD"] if env_present?("SIGNING_KEYCHAIN_PASSWORD")
  options
end

platform :ios do
  private_lane :app_store_api_key_from_env do
    if env_present?("ASC_KEY_ID") && env_present?("ASC_ISSUER_ID") && env_present?("ASC_KEY_FILE")
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: expanded_env_path("ASC_KEY_FILE"),
        duration: 1200,
        in_house: false
      )
    else
      nil
    end
  end

  desc "Build the app on CI without code signing"
  lane :ci_build do
    sh("xcodebuild -project #{Shellwords.escape(repo_path('LandscapeQuoteAI.xcodeproj'))} -scheme LandscapeQuoteAI -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO -quiet build")
  end

  desc "Build and upload a release archive to App Store Connect"
  lane :beta do
    api_key = app_store_api_key_from_env
    UI.user_error!("Set APPLE_TEAM_ID before uploading to TestFlight.") unless env_present?("APPLE_TEAM_ID")
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_FILE before uploading to TestFlight.") unless api_key

    cert(
      api_key: api_key,
      team_id: ENV["APPLE_TEAM_ID"],
      generate_apple_certs: false,
      **signing_keychain_options
    )

    certificate_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: ENV["APPLE_TEAM_ID"],
      cert_id: certificate_id,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.user_error!("Could not determine the App Store provisioning profile name.") unless profile_name.to_s.length.positive?

    build_app(
      project: repo_path("LandscapeQuoteAI.xcodeproj"),
      scheme: "LandscapeQuoteAI",
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: {
        destination: "upload",
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        },
        stripSwiftSymbols: true,
        uploadSymbols: true
      },
      export_team_id: ENV["APPLE_TEAM_ID"],
      skip_profile_detection: true,
      xcargs: signing_xcargs(profile_name: profile_name)
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload App Store Connect metadata only"
  lane :metadata do
    api_key = app_store_api_key_from_env
    options = {
      app_identifier: APP_IDENTIFIER,
      metadata_path: repo_path("fastlane", "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false
    }
    options[:api_key] = api_key if api_key

    deliver(**options)
  end

  desc "Upload metadata and the latest build, but do not submit for review"
  lane :release_candidate do
    beta
    metadata
  end
end
